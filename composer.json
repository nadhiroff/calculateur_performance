{
    "name": "rgz/calculateur-performance",
    "description": "Calculateur de performance Celtiis — PHP natif (sans framework), compatible PHP 8.1",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^2.1 || ^3.0 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.34"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
