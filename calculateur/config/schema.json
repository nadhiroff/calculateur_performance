{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paramètres du calculateur télécom (export JSON complet)",
  "type": "object",
  "required": ["version", "periodes", "partenaires"],
  "properties": {
    "version": { "const": 1 },
    "modifie": { "type": ["string", "null"], "format": "date-time" },
    "periodes": {
      "type": "object",
      "description": "Une entrée par mois, clé « AAAA-MM ». Objectifs et règles évoluent chaque mois.",
      "patternProperties": {
        "^\\d{4}-\\d{2}$": {
          "type": "object",
          "required": ["objectifs", "regles"],
          "properties": { "objectifs": { "$ref": "#/definitions/objectifs" }, "regles": { "$ref": "#/definitions/regles" } }
        }
      },
      "additionalProperties": false
    },
    "partenaires": { "$ref": "#/definitions/partenaires" }
  },
  "definitions": {
    "paliers": {
      "type": "array",
      "items": { "type": "object", "required": ["nom", "seuil", "prime"], "properties": { "nom": { "type": "string" }, "seuil": { "type": "number", "minimum": 0, "description": "TRO (1 = 100 %)" }, "prime": { "type": "number", "minimum": 0 } } }
    },
    "objectifs": {
      "type": "object",
      "required": ["periode", "calendrier", "equipes"],
      "properties": {
        "periode": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "calendrier": { "type": "object", "required": ["ouvres"], "properties": { "ouvres": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 31 }, "description": "Numéros des jours ouvrés du mois" } } },
        "commission_one_shot": { "type": "object", "properties": { "b2c": { "type": "number" }, "b2b": { "type": "number" } } },
        "equipes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "logins"],
            "properties": {
              "id": { "type": "string" }, "superviseur": { "type": ["string", "null"] }, "segment": { "type": ["string", "null"] },
              "part_rgz": { "type": "number", "minimum": 0, "maximum": 1, "description": "Part de la commission revenant à RGZ" },
              "logins": { "type": "array", "items": { "type": "object", "required": ["login", "b2c", "b2b"], "properties": { "login": { "type": "string" }, "b2c": { "type": "integer", "minimum": 0 }, "b2b": { "type": "integer", "minimum": 0 }, "primes": { "type": "boolean" } } } }
            }
          }
        }
      }
    },
    "regles": {
      "type": "object",
      "required": ["agent", "superviseur"],
      "properties": {
        "statuts_comptes": { "type": "array", "items": { "type": "string" } },
        "offres_comptees": { "type": "array", "items": { "type": "string" }, "description": "NOM_OFFRE comptés (casse, accents et espaces ignorés) ; liste vide = toutes les offres" },
        "segment_b2b": { "type": "object", "properties": { "champ": { "type": "string" }, "valeur": { "type": "string" } } },
        "seuil_montant_atypique": { "type": "number" },
        "agent": { "type": "object", "properties": { "journee_reussie": { "type": "number" }, "champion_du_jour": { "type": "object", "properties": { "prime": { "type": "number" }, "exige_objectif": { "type": "boolean" } } }, "paliers_tro": { "$ref": "#/definitions/paliers" }, "bonus_b2b": { "type": "number" } } },
        "superviseur": { "type": "object", "properties": { "journee_equipe": { "type": "number" }, "paliers_tro": { "$ref": "#/definitions/paliers" },
          "activation": { "type": "object", "properties": { "seuil_agent": { "type": "number" }, "taux_min": { "type": "number" } } }, "trophee": { "type": "object", "properties": { "enveloppe": { "type": "number" }, "tro_min": { "type": "number" } } } } }
      }
    },
    "partenaires": {
      "type": "object", "required": ["remplacements_login"],
      "properties": {
        "prioritaire": { "type": "string" }, "defaut": { "type": "string" },
        "version_regles": { "type": "integer", "description": "version du format des règles partenaires (2 = cahier des charges : liste nominative puis remplacements)" },
        "logins_partenaire": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } }, "description": "partenaire → logins sans préfixe (ex. POP&SHOP), testés en premier" },
        "remplacements_login": { "type": "array", "items": { "type": "object", "required": ["motif", "partenaire"], "properties": { "motif": { "type": "string" }, "partenaire": { "type": "string" } } }, "description": "le LOGIN_VENDEUR contient le motif (casse ignorée) → partenaire ; appliqués dans l'ordre" },
        "regles_agence": { "type": "array", "items": { "type": "object", "properties": { "motif": { "type": "string" }, "partenaire": { "type": "string" } } } },
        "historique": { "type": "object", "properties": { "annee": { "type": "integer" }, "mois": { "type": "array", "items": { "type": "string" } }, "partenaires": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "number" } } } } }
      }
    }
  }
}
